# Copy to .env for local development (docker compose up -d provides these services).

# Host ports used by docker-compose.yml
POSTGRES_PORT=5432
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101
# Origins allowed to PUT uploads into the bucket (comma-separated; applied by minio-init)
S3_CORS_ORIGINS=http://localhost:3000

NODE_ENV=development

DATABASE_URL=postgresql://blaxzy:blaxzy@localhost:5432/blaxzy
DATABASE_POOL_MAX=10

BETTER_AUTH_SECRET=dev-only-secret-change-me-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000
# Production: BETTER_AUTH_SECRET needs 32+ characters that are not the value above, BETTER_AUTH_URL must be
# set and https (BLAXZY: https://blaxzy.com; every email link is built from it).
# Behind a reverse proxy, tell auth rate limiting how to find the client address:
# comma-separated proxy IPs/CIDRs whose forwarded address is trusted ...
# AUTH_TRUSTED_PROXIES=10.0.0.0/8,fd00::/8
# ... or a header your proxy always overwrites with the client address
# AUTH_IP_HEADER=x-real-ip

# Claude API (damis). Optional: without it damis run in sample mode (see DAMI_MODE).
# ANTHROPIC_API_KEY=
# Only for a key that is not scoped to a workspace (the API then asks for this header):
# ANTHROPIC_WORKSPACE_ID=
# sample (default during testing: no Claude calls, no cost) | live | auto (sample without ANTHROPIC_API_KEY)
DAMI_MODE=sample
# Artificial latency of one sample-mode dami call, in milliseconds
DAMI_SAMPLE_DELAY_MS=3000
# Overrides every dami's default model (e.g. claude-sonnet-5-5 on staging). Unset = per-dami defaults.
# DAMI_DEFAULT_MODEL=
# Per-process limit on concurrent Claude calls, and retries for rate limits / overloads / network errors
DAMI_MAX_CONCURRENCY=4
DAMI_MAX_RETRIES=4

# Image/video generation: sample (placeholder images, no cost) | higgsfield (not wired yet)
GENERATION_PROVIDER=sample
# Higgsfield API key (KEY_ID:KEY_SECRET). Put the real value in .env.local (git-ignored), never here.
# `pnpm hf:seedance` runs one billable Seedance 2.5 test generation with it.
HF_CREDENTIALS=
# How long one sample generation takes, in milliseconds
GENERATION_SAMPLE_DELAY_MS=3000
# Generations one user may have running at once (extra ones wait in the queue)
GENERATION_MAX_PER_USER=3
# Generations still queued/running after this many minutes are failed and refunded (generation.sweep)
GENERATION_STUCK_AFTER_MINUTES=120
# ffmpeg for sample video; unset = the ffmpeg-static package, else ffmpeg on the PATH
# FFMPEG_PATH=/usr/bin/ffmpeg

S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=blaxzy
S3_ACCESS_KEY_ID=blaxzy
S3_SECRET_ACCESS_KEY=blaxzy-secret
S3_FORCE_PATH_STYLE=true
# Object store timeouts and attempts per call (milliseconds)
# S3_CONNECTION_TIMEOUT_MS=5000
# S3_REQUEST_TIMEOUT_MS=60000
# S3_MAX_ATTEMPTS=3
# Origin browsers use in presigned URLs, if different from S3_ENDPOINT (e.g. server in a container)
# S3_PUBLIC_ENDPOINT=http://localhost:9100

# Job queue (pg-boss, same database) and worker
JOBS_SCHEMA=pgboss
JOBS_WEB_POOL_MAX=2
JOBS_WORKER_POOL_MAX=10
WORKER_CONCURRENCY_DEFAULT=2
# Per job type overrides, e.g. script.generate=4,video.render=0 (0 = not on this worker)
WORKER_CONCURRENCY=
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_SHUTDOWN_TIMEOUT_SECONDS=25

# Email: "console" prints emails (with their links and tokens) to the server log, development only and
# refused when NODE_ENV=production; "smtp" sends them (needs SMTP_HOST and SMTP_PORT).
EMAIL_TRANSPORT=console
EMAIL_FROM=BLAXZY <no-reply@blaxzy.local>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# false/unset: plain connect, then STARTTLS is required (port 587); true: TLS from the start (port 465)
# SMTP_SECURE=false

# Fault injection, development and QA only (refused when NODE_ENV=production). Rules are
# target:kind[:probability], e.g. claude:429:0.3,claude:malformed:0.2,provider:5xx:1,s3:error:0.1,email:fail:1
# Targets: claude (429|5xx|529|connection|malformed), provider (5xx|429|timeout|fatal|lost), s3 (error), email (fail)
# FAULT_INJECT=
# FAULT_SEED=1

# Recovery and health: stuck-row sweep grace, worker heartbeat and readiness (see README)
STUCK_ROW_GRACE_MINUTES=15
WORKER_HEARTBEAT_SECONDS=30
WORKER_DOWN_AFTER_SECONDS=120
WORKER_DOWN_ALERT_MINUTES=30
HEALTH_CHECK_TIMEOUT_MS=2000
