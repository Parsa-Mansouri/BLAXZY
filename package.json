{
  "name": "blaxzy",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.2"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx worker/index.ts",
    "worker:dev": "tsx watch worker/index.ts",
    "worker:build": "esbuild worker/index.ts --bundle --platform=node --format=cjs --target=node22 --external:pg-native --external:sharp --external:ffmpeg-static --tsconfig=tsconfig.json --outfile=dist/worker.cjs",
    "migrate:build": "esbuild src/server/db/migrate.ts --bundle --platform=node --format=cjs --target=node22 --external:pg-native --tsconfig=tsconfig.json --outfile=dist/migrate.cjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "tsx --env-file=.env src/server/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "dev:user": "tsx scripts/dev-user.ts",
    "dami:run": "tsx scripts/dami-run.ts",
    "dev:script-flow": "tsx scripts/dev-script-flow.ts",
    "dev:credits": "tsx scripts/dev-credits.ts",
    "dev:generation": "tsx scripts/dev-generation.ts",
    "dev:preprod-flow": "tsx scripts/dev-preprod-flow.ts",
    "dev:sweep": "tsx scripts/dev-sweep.ts",
    "qa:crash": "tsx scripts/qa-crash.ts",
    "dev:production-flow": "tsx scripts/dev-production-flow.ts",
    "hf:seedance": "tsx --env-file=.env.local scripts/higgsfield-seedance.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "@aws-sdk/client-s3": "^3.1165.0",
    "@aws-sdk/s3-request-presigner": "^3.1165.0",
    "@base-ui/react": "^1.9.0",
    "@higgsfield/client": "^0.2.6",
    "better-auth": "^1.7.19",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "lucide-react": "^1.71.0",
    "motion": "^14.12.0",
    "next": "16.4.6",
    "nodemailer": "^10.5.0",
    "pdfjs-dist": "^6.5.438",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4.3.5",
    "@types/node": "22",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "9",
    "eslint-config-next": "16.4.6",
    "ffmpeg-static": "5.3.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "5",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "ffmpeg-static"
    ]
  }
}
