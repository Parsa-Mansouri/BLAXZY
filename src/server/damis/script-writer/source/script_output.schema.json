{
  "tools": [
    {
      "name": "submit_screenplay",
      "description": "Submit the final structured screenplay. This is the only permitted output.",
      "input_schema": {
        "type": "object",
        "required": [
          "story_parse",
          "beats",
          "screenplay",
          "added_assumptions",
          "validation",
          "warnings"
        ],
        "properties": {
          "story_parse": {
            "type": "object",
            "description": "Internal analysis of the raw story. Not shown to the user.",
            "required": [
              "characters",
              "central_action",
              "fixed_events",
              "desired_ending",
              "unknowns"
            ],
            "properties": {
              "characters": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name", "role", "want"],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "role": {
                      "type": "string"
                    },
                    "want": {
                      "type": "string"
                    },
                    "relationships": {
                      "type": "string"
                    }
                  }
                }
              },
              "central_action": {
                "type": "string"
              },
              "fixed_events": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "desired_ending": {
                "type": "string"
              },
              "unknowns": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "beats": {
            "type": "array",
            "description": "Playable beats in order. Not shown to the user.",
            "items": {
              "type": "object",
              "required": ["id", "type", "summary", "genre_effect", "style_effect"],
              "properties": {
                "id": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "opening_state",
                    "collision",
                    "escalation",
                    "intervention",
                    "turn",
                    "ending"
                  ]
                },
                "summary": {
                  "type": "string"
                },
                "genre_effect": {
                  "type": "string"
                },
                "style_effect": {
                  "type": "string"
                }
              }
            }
          },
          "screenplay": {
            "type": "object",
            "required": ["title", "logline", "language", "scenes", "estimated_duration_seconds"],
            "properties": {
              "title": {
                "type": "string"
              },
              "logline": {
                "type": "string"
              },
              "language": {
                "type": "string",
                "description": "BCP-47 tag of action and dialogue text, e.g. fa, en"
              },
              "estimated_duration_seconds": {
                "type": "integer"
              },
              "scenes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "scene_number",
                    "heading",
                    "purpose",
                    "change",
                    "elements",
                    "estimated_seconds"
                  ],
                  "properties": {
                    "scene_number": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "heading": {
                      "type": "object",
                      "required": ["int_ext", "location", "time_of_day"],
                      "properties": {
                        "int_ext": {
                          "type": "string",
                          "enum": ["INT", "EXT", "INT/EXT"]
                        },
                        "location": {
                          "type": "string",
                          "description": "Canonical location name, reused verbatim across scenes."
                        },
                        "time_of_day": {
                          "type": "string",
                          "enum": ["DAY", "NIGHT", "DAWN", "DUSK", "CONTINUOUS", "LATER"]
                        }
                      }
                    },
                    "purpose": {
                      "type": "string",
                      "description": "What this scene must accomplish. Not shown to the user."
                    },
                    "change": {
                      "type": "string",
                      "description": "What is different at the end of the scene. Not shown to the user."
                    },
                    "elements": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "required": ["type"],
                        "properties": {
                          "type": {
                            "type": "string",
                            "enum": ["action", "dialogue", "transition"]
                          },
                          "text": {
                            "type": "string",
                            "description": "For action: one short paragraph. For dialogue: the spoken line(s). For transition: the transition text."
                          },
                          "character": {
                            "type": "string",
                            "description": "dialogue only. Canonical character name."
                          },
                          "extension": {
                            "type": "string",
                            "enum": ["", "V.O.", "O.S."],
                            "description": "dialogue only."
                          },
                          "parenthetical": {
                            "type": "string",
                            "description": "dialogue only. 1-3 words, lowercase. Empty string if none."
                          }
                        }
                      }
                    },
                    "estimated_seconds": {
                      "type": "integer",
                      "minimum": 1,
                      "description": "Estimated runtime of this scene in seconds. Scene values must sum to screenplay.estimated_duration_seconds."
                    }
                  }
                }
              }
            }
          },
          "added_assumptions": {
            "type": "array",
            "description": "Every detail that was NOT in the user's story and was added to make a scene playable. Shown to the user for approval.",
            "items": {
              "type": "object",
              "required": ["text", "reason", "scene_number"],
              "properties": {
                "text": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                },
                "scene_number": {
                  "type": "integer"
                }
              }
            }
          },
          "validation": {
            "type": "object",
            "required": [
              "premise_preserved",
              "every_scene_has_goal_and_change",
              "cause_and_effect_clear",
              "genre_effect_traceable",
              "style_effect_traceable",
              "genre_and_style_kept_separate",
              "all_action_visible_or_audible",
              "names_and_props_consistent",
              "elements_valid",
              "no_production_directives",
              "within_duration_budget",
              "notes"
            ],
            "properties": {
              "premise_preserved": {
                "type": "boolean"
              },
              "every_scene_has_goal_and_change": {
                "type": "boolean"
              },
              "cause_and_effect_clear": {
                "type": "boolean"
              },
              "genre_effect_traceable": {
                "type": "boolean"
              },
              "style_effect_traceable": {
                "type": "boolean"
              },
              "genre_and_style_kept_separate": {
                "type": "boolean"
              },
              "all_action_visible_or_audible": {
                "type": "boolean"
              },
              "names_and_props_consistent": {
                "type": "boolean"
              },
              "elements_valid": {
                "type": "boolean"
              },
              "no_production_directives": {
                "type": "boolean"
              },
              "within_duration_budget": {
                "type": "boolean"
              },
              "notes": {
                "type": "string"
              }
            }
          },
          "warnings": {
            "type": "array",
            "description": "Problems the user or pipeline should know about (story too long for budget, conflicting genre/style, ending unclear, etc.).",
            "items": {
              "type": "string"
            }
          },
          "change_log": {
            "type": "array",
            "description": "Revision mode only. One entry per change made. Omit or leave empty in generation mode.",
            "items": {
              "type": "object",
              "required": ["scene_number", "change", "addresses"],
              "properties": {
                "scene_number": {
                  "type": "integer"
                },
                "change": {
                  "type": "string"
                },
                "addresses": {
                  "type": "string"
                }
              }
            }
          },
          "segment_id": {
            "type": "string",
            "description": "write_segment mode only."
          },
          "continuity_ledger": {
            "type": "object",
            "description": "write_segment mode only. State at the END of this segment, for the next segment.",
            "properties": {
              "introduced_characters": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "character_states": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name", "location", "visible_state"],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "location": {
                      "type": "string"
                    },
                    "visible_state": {
                      "type": "string",
                      "description": "clothing, injuries, what they carry"
                    }
                  }
                }
              },
              "prop_states": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name", "location_or_holder", "state"],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "location_or_holder": {
                      "type": "string"
                    },
                    "state": {
                      "type": "string"
                    }
                  }
                }
              },
              "open_threads": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "submit_outline",
      "description": "Submit the approved-for-review structure of a long piece. No scenes are written in this mode.",
      "input_schema": {
        "type": "object",
        "required": ["logline", "canonical_names", "acts", "proposed_additions", "warnings"],
        "properties": {
          "logline": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "canonical_names": {
            "type": "object",
            "required": ["characters", "locations", "props"],
            "properties": {
              "characters": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "locations": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "props": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "acts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["act", "purpose", "target_seconds", "sequences"],
              "properties": {
                "act": {
                  "type": "integer"
                },
                "purpose": {
                  "type": "string"
                },
                "target_seconds": {
                  "type": "integer"
                },
                "sequences": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["id", "summary", "target_seconds", "scenes"],
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "summary": {
                        "type": "string"
                      },
                      "target_seconds": {
                        "type": "integer",
                        "maximum": 480
                      },
                      "scenes": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "object",
                          "required": [
                            "scene_number",
                            "int_ext",
                            "location",
                            "time_of_day",
                            "characters",
                            "purpose",
                            "change",
                            "target_seconds"
                          ],
                          "properties": {
                            "scene_number": {
                              "type": "integer",
                              "minimum": 1
                            },
                            "int_ext": {
                              "type": "string",
                              "enum": ["INT", "EXT", "INT/EXT"]
                            },
                            "location": {
                              "type": "string"
                            },
                            "time_of_day": {
                              "type": "string",
                              "enum": ["DAY", "NIGHT", "DAWN", "DUSK", "CONTINUOUS", "LATER"]
                            },
                            "characters": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            },
                            "key_props": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            },
                            "purpose": {
                              "type": "string"
                            },
                            "change": {
                              "type": "string"
                            },
                            "target_seconds": {
                              "type": "integer",
                              "minimum": 1
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "proposed_additions": {
            "type": "array",
            "description": "New material (secondary characters, subplots, locations) needed to fill the runtime. NOT approved until the user accepts.",
            "items": {
              "type": "object",
              "required": ["text", "reason", "scene_numbers"],
              "properties": {
                "text": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                },
                "scene_numbers": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  }
                }
              }
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  ]
}
